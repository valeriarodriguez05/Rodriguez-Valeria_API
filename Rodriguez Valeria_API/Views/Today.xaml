<Page x:Class="Rodriguez_Valeria_API.Views.Today"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Rodriguez_Valeria_API.Views"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Today">

    <Grid Margin="20">
        <Border CornerRadius="15" Padding="20" Background="#1E2A38">
            <StackPanel>

                <!-- Température réelle -->
                <TextBlock Text="Température"
                       FontSize="16"
                       Foreground="LightGray"/>
                <TextBlock x:Name="TB_Temperature"
                       Text="-- °C"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,10"/>

                <!-- Température ressentie -->
                <TextBlock Text="Ressenti"
                       FontSize="16"
                       Foreground="LightGray"
                       Margin="0,10,0,0"/>
                <TextBlock x:Name="TB_FeelsLike"
                       Text="-- °C"
                       FontSize="24"
                       Foreground="White"
                       Margin="0,0,0,10"/>

                <!-- Humidité -->
                <TextBlock Text="Humidité"
                       FontSize="16"
                       Foreground="LightGray"
                       Margin="0,10,0,0"/>
                <TextBlock x:Name="TB_Humidity"
                       Text="-- %"
                       FontSize="20"
                       Foreground="White"
                       Margin="0,0,0,10"/>

                <!-- Précipitations pluie/neige -->
                <TextBlock Text="Précipitations"
                       FontSize="16"
                       Foreground="LightGray"
                       Margin="0,10,0,0"/>
                <TextBlock x:Name="TB_Precipitation"
                       Text="-- mm"
                       FontSize="20"
                       Foreground="White"/>
                <TextBlock x:Name="TB_PrecipitationType"
                       Text="Pluie / Neige"
                       FontSize="14"
                       Foreground="LightBlue"
                       Margin="0,0,0,10"/>

                <!-- Vent -->
                <TextBlock Text="Vent"
                       FontSize="16"
                       Foreground="LightGray"
                       Margin="0,10,0,0"/>
                <TextBlock x:Name="TB_Wind"
                       Text="-- km/h"
                       FontSize="20"
                       Foreground="White"/>
                <TextBlock x:Name="TB_WindGust"
                       Text="Rafales : -- km/h"
                       FontSize="14"
                       Foreground="LightGray"/>
                <TextBlock x:Name="TB_WindDirection"
                       Text="Direction : --"
                       FontSize="14"
                       Foreground="LightGray"/>

            </StackPanel>
        </Border>
    </Grid>

</Page>
