<UserControl x:Class="Rodriguez_Valeria_API.Views.Meteo_Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Rodriguez_Valeria_API.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#152951">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Recherche -->
            <RowDefinition Height="*"/>
            <!-- Température -->
            <RowDefinition Height="Auto"/>
            <!-- Boutons -->
        </Grid.RowDefinitions>

        <!-- Recherche ville -->
        <StackPanel Orientation="Horizontal"
         HorizontalAlignment="Center"
         Margin="0,0,0,15">
            <TextBox x:Name="TB_Ville"
          Width="220"
          Height="45"
          FontSize="20"
          Text="Annecy"
          Margin="0,0,15,0"/>
            <Button Content="Rechercher"
         Width="140"
         Height="45"
         FontSize="18"/>
        </StackPanel>

        <!-- Température principale -->
        <TextBlock x:Name="TB_Temp"
        Grid.Row="1"
        Text="-- °C"
        FontSize="72"
        FontWeight="Bold"
        Foreground="White"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

        <!-- Boutons prévisions -->
        <StackPanel Grid.Row="2"
         Orientation="Horizontal"
         HorizontalAlignment="Center"
         Margin="0,25,0,0">

            <Button Width="150" Height="120" Margin="10" Click="Btn_Today_Click">
                <StackPanel>
                    <TextBlock Text="Today" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="-- °C" x:Name="TB_Today" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="150" Height="120" Margin="10" Click="Btn_Tomorrow_Click">
                <StackPanel>
                    <TextBlock Text="Tomorrow" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="-- °C" x:Name="TB_Tomorrow" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="150" Height="120" Margin="10" Click="Btn_Day3_Click">
                <StackPanel>
                    <TextBlock Text="Day 3" x:Name="TB_Day3" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="-- °C" x:Name="TB_Temp_Day3" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="150" Height="120" Margin="10" Click="Btn_Day4_Click">
                <StackPanel>
                    <TextBlock Text="Day 4" x:Name="TB_Day4" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="-- °C" x:Name="TB_Temp_Day4" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="150" Height="120" Margin="10" Click="Btn_Day5_Click">
                <StackPanel>
                    <TextBlock Text="Day 5" x:Name="TB_Day5" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="-- °C" x:Name="TB_Temp_Day5" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
