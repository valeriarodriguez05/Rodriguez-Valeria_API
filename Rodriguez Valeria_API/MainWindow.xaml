<Window x:Class="Rodriguez_Valeria_API.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Météo App"
        Height="900"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F1419">

    <Window.Resources>
        <!-- Style pour les TextBlock de titre -->
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Style pour les boutons -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2D5A8F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A6FA8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A2332"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D5A8F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="12,8"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A2332"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D5A8F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Fond dégradé subtil -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0F1419" Offset="0"/>
                <GradientStop Color="#152951" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Contenu -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 🔝 HEADER -->
        <Grid Grid.Row="0" Margin="40,30,40,20">
            <TextBlock Style="{StaticResource TitleStyle}">
                <Run Text="☀️ " FontSize="28"/>
                <Run Text="Météo"/>
            </TextBlock>
        </Grid>

        <!-- 🧱 CONTENEUR PRINCIPAL -->
        <Border Grid.Row="1"
                Background="#1A2332"
                CornerRadius="20"
                Margin="40,0,40,20">
            <Border.Effect>
                <DropShadowEffect Color="Black" 
                                Opacity="0.3" 
                                BlurRadius="20" 
                                ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 🌍 SIDEBAR - Gestion des villes -->
                <Border Grid.Column="0"
        Background="#0F1419"
        CornerRadius="15"
        Padding="20"
        Margin="0,0,20,0">
                    <StackPanel>
                        <!-- Titre de la sidebar -->
                        <TextBlock Text="Mes villes"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

                        <!-- Zone de saisie -->
                        <TextBlock Text="Ajouter une ville"
                   Foreground="#9CA3AF"
                   FontSize="12"
                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,12">
                            <TextBox x:Name="TB_City"
         Height="40"
         FontSize="14"
         Foreground="Black"
         Background="White"
         VerticalContentAlignment="Center"
         Padding="10,0,10,0"
         TextChanged="TB_Ville_TextChanged"/>

                            <TextBlock x:Name="TB_Placeholder"
                       Text="Paris, Lyon, Annecy..."
                       Foreground="#9CA3AF"
                       FontSize="14"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="Visible"/>
                        </Grid>

                        <Button Content="+ Ajouter"
                Style="{StaticResource ModernButton}"
                Height="40"
                Click="Btn_AjouterVille_Click"
                Margin="0,0,0,25"/>

                        <!-- Séparateur -->
                        <Border Height="1"
                Background="#2D3748"
                Margin="0,0,0,20"/>

                        <!-- Liste des villes -->
                        <TextBlock Text="Villes enregistrées"
                   Foreground="#9CA3AF"
                   FontSize="12"
                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="CB_Villes"
                  Style="{StaticResource ModernComboBox}"
                  Height="40"
                  Foreground="Black"
                  SelectionChanged="CB_Villes_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <!-- 🌤 ZONE MÉTÉO PRINCIPALE -->
                <Border Grid.Column="1"
                        Background="#152951"
                        CornerRadius="15"
                        Padding="0">
                    <Grid x:Name="Grd_Container"/>
                </Border>
            </Grid>
        </Border>

        <!-- 🔻 FOOTER -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
            <TextBlock Text="Made with ❤️ by Valeria"
                       Foreground="#6B7280"
                       FontSize="12"/>
            <TextBlock Text=" • "
                       Foreground="#4B5563"
                       FontSize="12"
                       Margin="8,0"/>
            <TextBlock Text="v2.0"
                       Foreground="#6B7280"
                       FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
