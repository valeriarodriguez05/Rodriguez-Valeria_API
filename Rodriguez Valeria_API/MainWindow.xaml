<Window x:Class="Rodriguez_Valeria_API.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rodriguez_Valeria_API"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>

            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#2f5cb6"/>
        <Border Grid.Column ="1" Background="#1f3d7a"/>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#152951"/>
        <StackPanel Grid.Column="1" Margin="40,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="TB_Temp" Foreground="White" FontSize="25" Text="Températ"/>
            <TextBlock x:Name="TB_Clouds" Foreground="White" FontSize="25" Text="Clouds:"/>
            <TextBlock x:Name="TB_Humidity" Foreground="White" FontSize="25" Text="Humidité"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
            HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TB_High" Foreground="White" FontSize="25" Text="High: 66°" Margin="0,0,20,0"/>
            <TextBlock x:Name="TB_Low" Foreground="White" FontSize="25" Text="Low: 43°" Margin="0,0,20,0"/>
            <TextBlock x:Name="TB_FeelsLike" Foreground="White" FontSize="25" Text="Feels like:"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal"
    HorizontalAlignment="Center" VerticalAlignment="Top">
            <TextBox x:Name="TB_Ville" Foreground="White" FontSize="25" Text="Ville:°" Margin="0,0,20,0"/>
            
        </StackPanel>
        <Image Margin="20" Source="C:\Users\SLAB55\source\repos\Rodriguez Valeria_API\Rodriguez Valeria_API\image\image cloud.png"/>
    </Grid>
</Window>
