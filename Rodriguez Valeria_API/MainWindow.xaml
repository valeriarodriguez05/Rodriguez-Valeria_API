<Window x:Class="Rodriguez_Valeria_API.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Météo"
        Height="550"
        Width="1100"
        Background="#152951">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="441*"/>
            <ColumnDefinition Width="419*"/>
        </Grid.ColumnDefinitions>

        <!-- STRUCTURE PRINCIPALE -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titre -->
            <RowDefinition Height="*"/>
            <!-- Contenu -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 🔝 TITRE -->
        <Grid Grid.Row="0">
            <TextBlock Text="METEO" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="386,0,0,15" Grid.ColumnSpan="2"/>
        </Grid>
            

        <!-- 🧱 CONTENEUR CENTRAL -->
        <Border Grid.Row="1"
                Background="#1E3A6D"
                CornerRadius="15"
                Padding="20" Grid.ColumnSpan="2">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <!-- Gauche -->
                    <ColumnDefinition Width="*"/>
                    <!-- Droite -->
                </Grid.ColumnDefinitions>

                <!-- 🌍 LISTE DES VILLES (GAUCHE) -->
                <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">
                    <TextBlock Text="Villes enregistrées"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ComboBox x:Name="CB_Villes"
                              IsEditable="True"
                              Height="35"
                              FontSize="14"/>
                </StackPanel>

                <!-- 🌤 ZONE METEO (DROITE) -->
                <Grid Grid.Column="1" Name="Grd_Container">
                    <TextBox x:Name="TB_Ville" Width="220" Height="45" FontSize="20" Text="Annecy" Margin="0,0,15,0" VerticalAlignment="Top" />
                    <Button Content="Rechercher" Width="140" Height="45" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Button_Click"/>

                </Grid>
            </Grid>
        </Border>

        <!-- 🔻 FOOTER -->
        <TextBlock Grid.Row="2"
                   Text="Valeria V2"
                   Foreground="#BFD7ED"
                   FontSize="12"
                   HorizontalAlignment="Left"
                   Margin="404,15,0,0" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
