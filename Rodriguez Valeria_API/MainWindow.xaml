<Window x:Class="Rodriguez_Valeria_API.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Météo"
        Height="500"
        Width="900"
        Background="#152951">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Recherche ville -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10">
            <TextBox x:Name="TB_Ville"
                     Width="220"
                     Height="45"
                     FontSize="20"
                     Text="Annecy"
                     Margin="0,0,15,0"/>
            <Button Content="Rechercher"
                    Width="140"
                    Height="45"
                    FontSize="18"/>
        </StackPanel>

        <!-- Température principale -->
        <TextBlock x:Name="TB_Temp"
                   Grid.Row="1"
                   Text="-- °C"
                   FontSize="72"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!-- Boutons prévisions -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,30">

            <!-- TODAY -->
            <Button Width="150"
                    Height="120"
                    Margin="10"
                    Click="Btn_Today_Click">
                <StackPanel>
                    <TextBlock Text="Today"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="-- °C"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- TOMORROW -->
            <Button Width="150"
                    Height="120"
                    Margin="10"
                    Click="Btn_Tomorrow_Click">
                <StackPanel>
                    <TextBlock Text="Tomorrow"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="-- °C"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- DAY 3 -->
            <Button Width="150"
                    Height="120"
                    Margin="10"
                    Click="Btn_Day3_Click">
                <StackPanel>
                    <TextBlock Text="Day 3"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="-- °C"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- DAY 4 -->
            <Button Width="150"
                    Height="120"
                    Margin="10"
                    Click="Btn_Day4_Click">
                <StackPanel>
                    <TextBlock Text="Day 4"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="-- °C"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- DAY 5 -->
            <Button Width="150"
                    Height="120"
                    Margin="10"
                    Click="Btn_Day5_Click">
                <StackPanel>
                    <TextBlock Text="Day 5"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="-- °C"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</Window>
